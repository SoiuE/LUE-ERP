# Copy to deploy/.env for a full Docker deployment. Replace every CHANGE_ME value.
# Keep the same Compose project name on subsequent starts to reuse the same volumes.
MYSQL_DATABASE=lue_erp
MYSQL_USER=lue_erp
MYSQL_PASSWORD=CHANGE_ME_DATABASE_PASSWORD
MYSQL_ROOT_PASSWORD=CHANGE_ME_ROOT_PASSWORD
MINIO_ROOT_USER=lue_minio
MINIO_ROOT_PASSWORD=CHANGE_ME_OBJECT_STORAGE_PASSWORD
MINIO_BUCKET=lue-erp-images
MINIO_REGION=us-east-1
LUE_AUTH_SECRET=CHANGE_ME_WITH_AT_LEAST_32_RANDOM_CHARACTERS
LUE_ADMIN_USERNAME=admin
LUE_ADMIN_PASSWORD=CHANGE_ME_ADMIN_PASSWORD
# For a brand-new empty database. Review migrations before upgrading a database with data.
LUE_FLYWAY_ENABLED=true
# Use 0.0.0.0 and port 80 only when exposing the container directly.
LUE_WEB_BIND=127.0.0.1
LUE_WEB_PORT=8081
