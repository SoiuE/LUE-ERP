# Copy this file to backend/.env and replace the password locally.
LUE_DB_URL=jdbc:mysql://127.0.0.1:3306/lue_erp?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai&allowPublicKeyRetrieval=true&useSSL=false
LUE_DB_USERNAME=lue_erp_app
LUE_DB_PASSWORD=123456

LUE_REDIS_HOST=localhost
LUE_REDIS_PORT=6379
LUE_REDIS_PASSWORD=

# These local-development values match deploy/.env.example. Replace them before shared deployment.
# The S3-compatible Docker service listens on http://localhost:9000.
LUE_IMAGE_STORAGE_TYPE=minio
LUE_MINIO_ENDPOINT=http://localhost:9000
LUE_MINIO_BUCKET=lue-erp-images
LUE_MINIO_ACCESS_KEY=lue_minio
LUE_MINIO_SECRET_KEY=lue_minio_password
LUE_MINIO_REGION=us-east-1
LUE_IMAGE_MAX_FILE_SIZE=10485760
LUE_IMAGE_MAX_PIXELS=20000000
LUE_IMAGE_MAX_DIMENSION=8000
LUE_IMAGE_ARCHIVE_CONNECT_TIMEOUT_MS=3000
LUE_IMAGE_ARCHIVE_READ_TIMEOUT_MS=7000
LUE_IMAGE_ARCHIVE_CALL_TIMEOUT_MS=12000
LUE_IMAGE_ARCHIVE_MAX_FILE_SIZE=10485760
LUE_IMAGE_ARCHIVE_MAX_REDIRECTS=3
LUE_IMAGE_ARCHIVE_WORKERS=2
LUE_IMAGE_ARCHIVE_QUEUE_CAPACITY=20
LUE_IMAGE_ARCHIVE_POLL_DELAY_MS=3000
LUE_IMAGE_SEARCH_URL=http://127.0.0.1:8090
LUE_IMAGE_SEARCH_INTERNAL_TOKEN=
LUE_IMAGE_SEARCH_CONNECT_TIMEOUT_MS=2000
LUE_IMAGE_SEARCH_READ_TIMEOUT_MS=15000
LUE_IMAGE_INDEX_POLL_DELAY_MS=3000
LUE_IMAGE_SEARCH_MINIMUM_SCORE=0.20
LUE_IMAGE_SEARCH_INCLUDE_PACKAGING=false
